# Copy to .env.local and fill in. Never commit real keys.

# Public site URL (no trailing slash), used for canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=https://[DOMAIN]

# Booking notification emails via Resend (https://resend.com).
# Leave empty to run booking in demo mode (nothing is sent).
RESEND_API_KEY=
# Where new booking requests are sent (your team inbox).
BOOKING_NOTIFY_TO=
# Sender address on a domain verified in Resend.
BOOKING_EMAIL_FROM="Bookings <bookings@[DOMAIN]>"

# Razorpay (Phase 4+: not wired up yet).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
